# Copy to .env in the project root. The Settings page in the dashboard writes the
# AI keys and ntfy topic here for you, so you normally only set the Clerk line by hand.

# Lets the backend check that settings changes come from a signed-in dashboard user.
# Use the same value as NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in web-frontend/.env.local.
# Without it, settings can only be changed from the machine running the backend.
CLERK_PUBLISHABLE_KEY=

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Managed from Settings -> AI providers / Push notifications
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NTFY_TOPIC=
