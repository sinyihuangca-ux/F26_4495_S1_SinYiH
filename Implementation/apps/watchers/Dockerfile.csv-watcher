# Build context: watchers/   (docker build -f watchers/Dockerfile.csv-watcher watchers/)
#
# Runs as root so it can move CSVs (created by the root pcap-watcher) into csvs/processed|failed.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY csv_inference_watcher.py .
CMD ["python", "-u", "csv_inference_watcher.py"]
