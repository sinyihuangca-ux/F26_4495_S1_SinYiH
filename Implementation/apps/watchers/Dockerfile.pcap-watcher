# Build context: watchers/   (docker build -f watchers/Dockerfile.pcap-watcher watchers/)
#
# Runs as root on purpose: it talks to the host docker daemon through the mounted
# /var/run/docker.sock (root-equivalent anyway) and deletes/moves uploaded pcaps.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Static docker CLI only (no apt repo / curl / gnupg). It negotiates the API version with the host daemon.
COPY --from=docker:27.5.1-cli /usr/local/bin/docker /usr/local/bin/docker

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY pcap_watcher.py .
CMD ["python", "-u", "pcap_watcher.py"]
