CAPTURE_INTERFACE=eth0
CAPTURE_OUTPUT_DIR=/var/captures
# Identify this machine on the server; letters, digits, '.', '_' and '-' only.
USER_ID=oke123
COMPUTER_ID=laptop_12
INTERVAL_SECONDS=15
# Local user that owns the capture files and runs sync_to_server.sh (default: the user running capture.sh)
#CAPTURE_USER=oke
# Max closed pcap files kept locally while the server is unreachable (0 = unlimited)
MAX_FILES=100
SERVER_USER=pipeline
SERVER_IP=your.cloud.server.ip.address
SSH_KEY_PATH=/home/oke/.ssh/pipeline_rsa
# Files are uploaded to <REMOTE_USERS_ROOT>/<USER_ID>/comp/<COMPUTER_ID>/pcaps/
REMOTE_USERS_ROOT=/srv/app/users
