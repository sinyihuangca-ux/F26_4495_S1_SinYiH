# Files executed inside Linux containers or on Linux hosts must keep LF line endings,
# even in Windows working copies (core.autocrlf=true), or docker builds from Windows break.
*.sh            text eol=lf
gradlew         text eol=lf
Dockerfile*     text eol=lf
*.py            text eol=lf
*.properties    text eol=lf
*.yml           text eol=lf
.env.example    text eol=lf
